# ============================================================
#  Dual-Video RAG Chatbot — backend configuration
#  Copy to `.env` and fill in. Only an LLM key is strictly required.
# ============================================================

# ---- LLM provider ----
# Pick ONE provider. Gemini Flash is the cheapest high-quality default.
#   google_genai  -> set GOOGLE_API_KEY, LLM_MODEL=gemini-2.0-flash
#   openai        -> set OPENAI_API_KEY, LLM_MODEL=gpt-4o-mini
#                    (for OpenRouter/other gateways also set OPENAI_BASE_URL
#                     and use the gateway's model id, e.g. openai/gpt-4o-mini)
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2

GOOGLE_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-or-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- Embeddings (local ONNX, free — no key needed) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Vector DB (Qdrant) ----
# Leave QDRANT_URL empty for embedded/local mode (no Docker).
# To use Qdrant Cloud, set both:
# QDRANT_URL=https://your-cluster.qdrant.tech
# QDRANT_API_KEY=your-qdrant-key
QDRANT_PATH=./.qdrant_data
QDRANT_COLLECTION=video_chunks

# ---- Chunking / retrieval ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=6

# ---- Whisper fallback (local CPU STT for caption-less videos) ----
WHISPER_ENABLED=true
WHISPER_MODEL=tiny

# ---- Instagram authentication ----
# Instagram blocks anonymous yt-dlp requests. Use ONE of these to authenticate.
# Cookies are read locally and only sent to the originating platform.
#   chrome | edge | firefox | brave | opera | vivaldi
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=./ig_cookies.txt

# ---- App ----
CORS_ORIGINS=http://localhost:3000
